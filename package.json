{
  "name": "yog",
  "version": "0.1.0",
  "description": "Virtual file system agent harness",
  "license": "MIT",
  "author": "haliphax <haliphax@gmail.com>",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=dot --silent=true --tagsFilter \"!mount\" .",
    "test:mount": "vitest run --tagsFilter mount test/mount.test.ts",
    "depcruise": "dependency-cruiser src test --config .dependency-cruiser.cjs",
    "depcruise:graph": "dependency-cruiser src --output-type mermaid",
    "prepare": "husky"
  },
  "dependencies": {
    "agentfs-sdk": "^0.6.4",
    "better-sqlite3": "^13.0.3",
    "fuse-native": "^2.2.6",
    "openai": "^7.43.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.7.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "nano-staged": {
    "**/*.ts": [
      "oxfmt",
      "oxlint"
    ]
  }
}
