{
  "name": "yog",
  "version": "0.1.0",
  "description": "Virtual file system agent harness",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=dot --silent=true .",
    "test:mount": "node scripts/mount-test.ts",
    "prepare": "husky"
  },
  "nano-staged": {
    "**/*.ts": [
      "oxfmt",
      "oxlint"
    ]
  },
  "author": "haliphax <haliphax@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "fuse-native": "^2.2.6",
    "openai": "^7.43.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
