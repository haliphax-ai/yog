#!/usr/bin/env bash
set -eo pipefail

# This script lives in the assets/ checkout; the repo root is its parent.
ASSETS="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$ASSETS/.." && pwd)"

# Regenerate the mermaid source from the main branch source tree.
cd "$ROOT"
npm run depcruise:graph -- -f assets/dependencies.mmd -I src -x '\.d\.ts$'

# Render the diagram inside the assets checkout.
cd "$ASSETS"
sed -i'' 's#flowchart LR#flowchart TD#' dependencies.mmd
mmdc -p puppeteer.json -i dependencies.mmd -o dependencies.png -b white --size 2048 -t redux-color
/usr/bin/gm convert dependencies.png dependencies.jpg
rm dependencies.png
