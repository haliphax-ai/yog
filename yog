#!/usr/bin/env bash
set -eo pipefail

model="nvidia/nemotron-3-ultra-550b-a55b:free"

[[ ! -f "model" ]] || model="$(cat model)"
[[ ! -f ".env" ]] || source .env

exec docker run \
  --rm \
  --security-opt seccomp=unconfined \
  --security-opt apparmor=yog \
  --device /dev/fuse \
  --cap-add SYS_ADMIN \
  -e OPENAI_BASE_URL \
  -e OPENAI_API_KEY \
  --name yog \
  -t yog run "$model" "$@"
